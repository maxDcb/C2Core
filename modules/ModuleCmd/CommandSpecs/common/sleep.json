{
  "name": "sleep",
  "display_name": "sleep",
  "kind": "common",
  "description": "Set the beacon sleep interval in seconds.",
  "command_template": "sleep {seconds}",
  "target": "beacon",
  "requires_session": true,
  "platforms": ["windows", "linux"],
  "archs": ["any"],
  "args": [
    {
      "name": "seconds",
      "type": "number",
      "required": true,
      "description": "Sleep interval in seconds."
    }
  ],
  "examples": ["sleep 0.5"],
  "source": "manifest"
}
