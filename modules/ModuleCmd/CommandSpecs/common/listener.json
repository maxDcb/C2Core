{
  "name": "listener",
  "display_name": "listener",
  "kind": "common",
  "description": "Start or stop a TCP/SMB listener on the beacon.",
  "target": "beacon",
  "requires_session": true,
  "platforms": ["windows", "linux"],
  "archs": ["any"],
  "args": [
    {
      "name": "action",
      "type": "enum",
      "required": true,
      "description": "Listener action.",
      "values": ["start", "stop"]
    },
    {
      "name": "type_or_hash",
      "type": "text",
      "required": true,
      "description": "Listener type for start, or listener hash for stop.",
      "values": ["tcp", "smb"]
    },
    {
      "name": "host",
      "type": "text",
      "required": false,
      "description": "Host/IP displayed for the listener."
    },
    {
      "name": "port_or_pipe",
      "type": "text",
      "required": false,
      "description": "TCP port or SMB pipe name."
    }
  ],
  "examples": [
    "listener start tcp 10.2.4.8 4444",
    "listener start smb host1 pipe1",
    "listener stop <listener_hash>"
  ],
  "source": "manifest"
}
